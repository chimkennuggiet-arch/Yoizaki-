<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YOIZAKI TOKYO STREET FOOD - Pre-Order</title>
  <style>
    :root {
      --bg-color: #0f0f12;
      --card-bg: #18181c;
      --accent-color: #ff3b4e;
      --text-color: #ffffff;
      --text-sub: #a0a0ab;
      --border-color: #2e2e35;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      margin: 0;
      padding: 20px 12px;
      box-sizing: border-box;
    }

    .container {
      max-width: 540px;
      margin: 0 auto;
      background: var(--card-bg);
      padding: 24px 20px;
      border-radius: 16px;
      border: 1px solid var(--border-color);
      box-shadow: 0 8px 24px rgba(0,0,0,0.6);
    }

    .header {
      text-align: center;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 16px;
    }

    .header h1 {
      margin: 0;
      font-size: 1.8em;
      color: var(--accent-color);
      letter-spacing: 1px;
    }

    .header p {
      margin: 6px 0 0;
      color: var(--text-sub);
      font-size: 0.9em;
    }

    .section-title {
      font-size: 1.1em;
      font-weight: 600;
      margin: 20px 0 12px;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .menu-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #222228;
      padding: 14px 16px;
      margin-bottom: 12px;
      border-radius: 10px;
      border: 1px solid var(--border-color);
    }

    .menu-info {
      display: flex;
      flex-direction: column;
    }

    .menu-name {
      font-weight: 600;
      font-size: 1em;
    }

    .menu-price {
      color: var(--accent-color);
      font-size: 0.9em;
      margin-top: 4px;
      font-weight: 500;
    }

    .quantity-control {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn-qty {
      background: var(--accent-color);
      color: #fff;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }

    .btn-qty:active {
      transform: scale(0.95);
    }

    .qty-display {
      font-size: 1.1em;
      font-weight: bold;
      min-width: 20px;
      text-align: center;
    }

    .total-container {
      text-align: right;
      background: #121215;
      padding: 12px 16px;
      border-radius: 8px;
      margin-top: 16px;
      font-size: 1.1em;
      border: 1px solid var(--border-color);
    }

    .total-amount {
      color: var(--accent-color);
      font-weight: bold;
      font-size: 1.2em;
    }

    .form-group {
      margin-top: 16px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-size: 0.9em;
      color: #ddd;
    }

    input, select {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      background: #222228;
      color: #fff;
      font-size: 0.95em;
      box-sizing: border-box;
      outline: none;
    }

    input:focus, select:focus {
      border-color: var(--accent-color);
    }

    .error-text {
      color: #ff4757;
      font-size: 0.85em;
      margin-top: 6px;
      display: none;
    }

    .qr-box {
      text-align: center;
      background: #222228;
      padding: 16px;
      border-radius: 10px;
      margin-top: 20px;
      border: 1px dashed var(--accent-color);
    }

    .qr-box img {
      max-width: 180px;
      width: 100%;
      height: auto;
      border-radius: 8px;
      margin: 12px 0;
    }

    .file-input-wrapper {
      margin-top: 12px;
    }

    .submit-button {
      width: 100%;
      background: var(--accent-color);
      color: white;
      border: none;
      padding: 16px;
      border-radius: 10px;
      font-size: 1.1em;
      font-weight: bold;
      margin-top: 24px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .submit-button:hover {
      background: #e02f42;
    }
  </style>
</head>
<body>

<div class="container">
  <div class="header">
    <h1>宵崎 YOIZAKI</h1>
    <p>Tokyo Street Food Pre-Order</p>
  </div>

  <!-- Formspreeを利用してchimkennuggiet@gmail.comへ直接メール送信 -->
  <form action="https://formspree.io/f/mqakpgyy" method="POST" enctype="multipart/form-data" id="preOrderForm" onsubmit="return handleFormSubmit()">
    
    <!-- 自動メールの送信先と件名設定 -->
    <input type="hidden" name="_to" value="chimkennuggiet@gmail.com">
    <input type="hidden" name="_subject" value="【YOIZAKI】新しい事前予約が入りました">

    <div class="section-title">🍱 1. メニュー選択</div>

    <div class="menu-item">
      <div class="menu-info">
        <span class="menu-name">焼きそば (Yakisoba)</span>
        <span class="menu-price">Rp 25,000</span>
      </div>
      <div class="quantity-control">
        <button type="button" class="btn-qty" onclick="adjustQuantity('yakisoba', -1)">-</button>
        <span id="display-yakisoba" class="qty-display">0</span>
        <button type="button" class="btn-qty" onclick="adjustQuantity('yakisoba', 1)">+</button>
      </div>
    </div>
    <input type="hidden" name="注文_焼きそば" id="input-yakisoba" value="0">

    <div class="menu-item">
      <div class="menu-info">
        <span class="menu-name">ラムネ (Ramune)</span>
        <span class="menu-price">Rp 15,000</span>
      </div>
      <div class="quantity-control">
        <button type="button" class="btn-qty" onclick="adjustQuantity('ramune', -1)">-</button>
        <span id="display-ramune" class="qty-display">0</span>
        <button type="button" class="btn-qty" onclick="adjustQuantity('ramune', 1)">+</button>
      </div>
    </div>
    <input type="hidden" name="注文_ラムネ" id="input-ramune" value="0">

    <div class="total-container">
      合計金額: <span id="totalText" class="total-amount">Rp 0</span>
    </div>
    <input type="hidden" name="合計金額" id="input-total" value="Rp 0">

    <div class="section-title">👤 2. お客様情報</div>

    <div class="form-group">
      <label>お名前 (Full Name) *</label>
      <input type="text" name="お名前" required placeholder="例: 山田 太郎">
    </div>

    <div class="form-group">
      <label>WhatsApp / 電話番号 *</label>
      <input type="tel" name="電話番号" required placeholder="例: +62 812-3456-7890">
    </div>

    <div class="form-group">
      <label>受取希望日 (Pickup Date) * <span style="color:var(--accent-color);">※当日予約不可</span></label>
      <input type="date" id="pickupDate" name="受取希望日" required onchange="validatePickupDate()">
      <div id="dateError" class="error-text">⚠️ 当日（今日）および過去の日付は事前予約できません。明日以降の日付をお選びください。</div>
    </div>

    <div class="form-group">
      <label>受取方法 *</label>
      <select name="受取方法" required>
        <option value="Pick Up (店頭受取)">Pick Up (店頭受取)</option>
        <option value="Drive Thru (ドライブスルー)">Drive Thru (ドライブスルー)</option>
      </select>
    </div>

    <div class="section-title">💳 3. お支払い (必須)</div>

    <div class="qr-box">
      <div style="font-weight: bold; margin-bottom: 4px;">▼ 決済用 QRIS コード</div>
      <p style="font-size: 0.85em; color: var(--text-sub); margin: 0;">以下のQRコードから合計金額をお支払いください。</p>
      <!-- QR画像をGitHubにアップロード後にファイル名を指定（例: qr.png） -->
      <img src="qr.png" alt="Payment QR Code" onerror="this.src='https://via.placeholder.com/180x180.png?text=Payment+QR'">
    </div>

    <div class="form-group file-input-wrapper">
      <label>お支払い証明（レシート/スクリーンショット画像） *</label>
      <input type="file" name="支払い証明画像" accept="image/*" required>
    </div>

    <button type="submit" class="submit-button">予約を確定して送信する</button>
  </form>
</div>

<script>
  const itemPrices = { yakisoba: 25000, ramune: 15000 };
  const itemQuantities = { yakisoba: 0, ramune: 0 };

  function adjustQuantity(itemKey, change) {
    itemQuantities[itemKey] = Math.max(0, itemQuantities[itemKey] + change);
    document.getElementById(`display-${itemKey}`).innerText = itemQuantities[itemKey];
    document.getElementById(`input-${itemKey}`).value = itemQuantities[itemKey];
    calculateTotal();
  }

  function calculateTotal() {
    const total = (itemQuantities.yakisoba * itemPrices.yakisoba) + (itemQuantities.ramune * itemPrices.ramune);
    const formattedTotal = `Rp ${total.toLocaleString()}`;
    document.getElementById('totalText').innerText = formattedTotal;
    document.getElementById('input-total').value = formattedTotal;
  }

  // 当日・過去日付の予約拒否チェック
  function validatePickupDate() {
    const dateInput = document.getElementById('pickupDate');
    const errorDisplay = document.getElementById('dateError');
    
    if (!dateInput.value) return;

    const selectedDate = new Date(dateInput.value + 'T00:00:00');
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // 当日またはそれ以前を選択した場合
    if (selectedDate <= today) {
      errorDisplay.style.display = 'block';
      dateInput.value = '';
    } else {
      errorDisplay.style.display = 'none';
    }
  }

  function handleFormSubmit() {
    const total = (itemQuantities.yakisoba * itemPrices.yakisoba) + (itemQuantities.ramune * itemPrices.ramune);
    if (total === 0) {
      alert('商品を1点以上選択してください。');
      return false;
    }
    return true;
  }
</script>

</body>
</html>
